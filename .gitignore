# Virtual environments
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment and secrets
.env
.env.local

# Local application logs (class A — never commit; purged on service start)
logs/*
!logs/.gitkeep

# Operational stores (never commit real family data)
# - data/confirmations/ class C — purged by maintain_confirmation_storage
# - data/life_notes/ class F — until family deletes (not auto-purged as logs)
data/*
!data/.gitkeep


# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~

# Personal files
*.my_notes.txt

# Personal / machine-local docs (not for GitHub)
*.local.md
docs/deploy-mac-mini.local.md
my-notes/
