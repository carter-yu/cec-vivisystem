# cec-vivisystem environment variables
# Copy this file to .env and fill in real values locally.
# Never commit .env (see ground rule 13: Secrets Stay Local).

# --- App ---
LOG_LEVEL=INFO
# Optional: override log root (default: <repo>/logs). Class A; purged on start.
# CEC_LOG_DIR=
# Set to 0 to disable file logging (stdout only)
# CEC_LOG_TO_FILE=1

# --- Slack (Phase 2 Listener+) ---
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# App-level token for Socket Mode (xapp-...)
SLACK_APP_TOKEN=
# Signing secret (Events API / request verification; optional if Socket Mode only)
SLACK_SIGNING_SECRET=
# Slack channel ids (C…). One env var per family channel.
# #family-plans — calendar parse path (Listener)
SLACK_FAMILY_PLANS_CHANNEL_ID=
# #family-life-notes — LifeNotesKeeper (Listener wiring still stretch)
SLACK_LIFE_NOTES_CHANNEL_ID=

# --- Google Calendar (future phases; leave empty until needed) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: path to a gitignored OAuth client JSON (never commit the file)
# GOOGLE_CREDENTIALS_PATH=

# --- Optional LLM (only if a future ADR adopts LLM behind the parse contract) ---
# LLM_API_KEY=
# LLM_BASE_URL=
