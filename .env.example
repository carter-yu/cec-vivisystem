# cec-vivisystem environment variables
# Copy this file to .env and fill in real values locally.
# Never commit .env (see ground rule 13: Secrets Stay Local).

# --- App ---
LOG_LEVEL=INFO
# Optional: override log root (default: <repo>/logs). Class A; purged on start.
# CEC_LOG_DIR=
# Set to 0 to disable file logging (stdout only)
# CEC_LOG_TO_FILE=1

# --- Slack (Phase 2 Listener+) ---
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# App-level token for Socket Mode (xapp-...)
SLACK_APP_TOKEN=
# Signing secret (Events API / request verification; optional if Socket Mode only)
SLACK_SIGNING_SECRET=
# Slack channel ids (C…). One env var per family channel.
# #family-plans — calendar parse path (Listener)
SLACK_FAMILY_PLANS_CHANNEL_ID=
# #family-life-notes — LifeNotesKeeper dispatch (Phase 5B)
SLACK_LIFE_NOTES_CHANNEL_ID=

# --- System-status channel (Phase 29/30; ADR 0014) ---
# Channel id (C…/G…) of the private #vivi-status channel; invite the bot.
# Receives health alerts, the 09:00 daily status and Google token notices.
# Empty = falls back to SLACK_FAMILY_PLANS_CHANNEL_ID with a WARNING log
# (system_channel_fallback). Uses SLACK_BOT_TOKEN. Read on every run.
# CEC_HEALTH_ALERT_CHANNEL_ID=

# --- Stuck Slack connection (Phase 30; listener reads these at start) ---
# Stuck = disconnected now and no connection lasted 5 min in this window.
# Integer seconds, 300-86400. Default 900.
# CEC_LISTENER_STUCK_AFTER_S=900
# In-process reconnect retries before exit code 75 (launchd restarts).
# Integer 0-10. Default 3. 0 = exit at once when stuck.
# CEC_LISTENER_STUCK_RETRIES=3
# Seconds between retries, 15-3600. Default 120.
# CEC_LISTENER_STUCK_RETRY_WAIT_S=120
# Invalid values log listener_stuck_config_invalid and use the default.

# --- Google Calendar (Phase 6 Writer; leave empty until live smoke) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Testing-mode refresh tokens expire after 7 days (invalid_grant). Re-consent
# and paste a new value, then restart the live Listener. Never commit the value.
GOOGLE_REFRESH_TOKEN=
# ISO datetime or YYYY-MM-DD when the current refresh token was obtained
# (10:00 HKT notice to the status channel at 3/2/1 days left, then daily
# "expired" until re-authorized; also shown in the 09:00 daily status).
# Set by the local consent helper.
GOOGLE_REFRESH_TOKEN_ISSUED_AT=
# Optional; default 7 (Google Testing). Not a secret.
# GOOGLE_TOKEN_TTL_DAYS=7
# Target calendar: "primary" or the calendar id from Settings → Integrate calendar
GOOGLE_CALENDAR_ID=primary
# Optional: path to a gitignored OAuth client JSON (never commit the file)
# GOOGLE_CREDENTIALS_PATH=

# --- Hybrid parse fallback (Phase 18 / ADR 0005; optional on Mini) ---
# SpaceXAI key. Empty = rules-only; create-looking misses still recorded.
# XAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.5
# Non-reasoning SKU is tried first when LLM_MODEL is grok-4.5 (15s Slack budget).
# Set equal to LLM_MODEL to disable the second model.
# LLM_FALLBACK_MODEL=grok-4.20-0309-non-reasoning
