# cec-vivisystem environment variables
# Copy this file to .env and fill in real values locally.
# Never commit .env (see ground rule 13: Secrets Stay Local).

# --- App ---
LOG_LEVEL=INFO
# Optional: override log root (default: <repo>/logs). Class A; purged on start.
# CEC_LOG_DIR=
# Set to 0 to disable file logging (stdout only)
# CEC_LOG_TO_FILE=1

# --- Slack (Phase 2 Listener+) ---
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# App-level token for Socket Mode (xapp-...)
SLACK_APP_TOKEN=
# Signing secret (Events API / request verification; optional if Socket Mode only)
SLACK_SIGNING_SECRET=
# Slack channel ids (C…). One env var per family channel.
# #family-plans — calendar parse path (Listener)
SLACK_FAMILY_PLANS_CHANNEL_ID=
# #family-life-notes — LifeNotesKeeper dispatch (Phase 5B)
SLACK_LIFE_NOTES_CHANNEL_ID=

# --- System-status channel (Phase 29/30; ADR 0014) ---
# Channel id (C…/G…) of the private #vivi-status channel; invite the bot.
# Receives health alerts, the 09:00 daily status and Google token notices.
# Empty = falls back to SLACK_FAMILY_PLANS_CHANNEL_ID with a WARNING log
# (system_channel_fallback). Uses SLACK_BOT_TOKEN. Read on every run.
# CEC_HEALTH_ALERT_CHANNEL_ID=

# --- AIA Medic librarian (Phase 32; ADR 0017) ---
# #jeff-aia-medic channel id; invite the Vivi bot. Messages there get Q&A from
# the plan documents only (never Calendar). Unset/empty = this default;
# "off" disables the route. Must differ from the plans and life-notes ids.
CEC_MEDIC_CHANNEL_ID=C0CB179V0AE
# Optional: directory with the built tree.json. Default
# data/agent_librarian/jeff-aia-medic; falls back to knowledge/jeff-aia-medic.
# CEC_MEDIC_KB_DIR=
# Answers use XAI_API_KEY / LLM_* below; without a key the bot quotes matching
# lines from the tree instead.

# --- Stuck Slack connection (Phase 30; listener reads these at start) ---
# Stuck = disconnected now and no connection lasted 5 min in this window.
# Integer seconds, 300-86400. Default 900.
# CEC_LISTENER_STUCK_AFTER_S=900
# In-process reconnect retries before exit code 75 (launchd restarts).
# Integer 0-10. Default 3. 0 = exit at once when stuck.
# CEC_LISTENER_STUCK_RETRIES=3
# Seconds between retries, 15-3600. Default 120.
# CEC_LISTENER_STUCK_RETRY_WAIT_S=120
# Invalid values log listener_stuck_config_invalid and use the default.

# --- Mini control app (Phase 31; ADR 0015) ---
# Needs `uv sync --locked --extra control`. LAN only, HTTP first.
# Bind address: a loopback or private LAN IP with port. Never 0.0.0.0 or a
# public address (the app refuses them). Default 127.0.0.1:8730.
# CEC_CONTROL_BIND=192.168.1.20:8730
# Client networks allowed to connect (comma list; loopback or private only).
# Default: loopback plus the /24 of CEC_CONTROL_BIND.
# CEC_CONTROL_ALLOWED_NETS=192.168.1.0/24
# Extra Host names (comma list) besides localhost, 127.0.0.1, the bind IP and
# this machine's name (+ .local).
# CEC_CONTROL_HOSTS=mac-mini.local
# Optional HTTPS later (for example mkcert); set both or neither. With HTTPS,
# cookies become __Host- + Secure and HSTS is sent.
# CEC_CONTROL_TLS_CERT=
# CEC_CONTROL_TLS_KEY=
# Accounts live in data/control/users.json (mode 0600), made with
# `python -m cec_vivisystem.control adduser <name> --role admin|member`.
# The app writes only these .env keys (with a backup in data/control/env-backups/):
# SLACK_FAMILY_PLANS_CHANNEL_ID, SLACK_LIFE_NOTES_CHANNEL_ID,
# CEC_HEALTH_ALERT_CHANNEL_ID, CEC_LISTENER_STUCK_RETRIES,
# GOOGLE_REFRESH_TOKEN and GOOGLE_REFRESH_TOKEN_ISSUED_AT.

# --- Google Calendar (Phase 6 Writer; leave empty until live smoke) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Testing-mode refresh tokens expire after 7 days (invalid_grant). Re-authorize
# in the control app (Phase 31b, ADR 0016), which writes this value and the
# issue date, then restart the live Listener. Never commit the value.
GOOGLE_REFRESH_TOKEN=
# ISO datetime or YYYY-MM-DD when the current refresh token was obtained
# (10:00 HKT notice to the status channel at 3/2/1 days left, then daily
# "expired" until re-authorized; also shown in the 09:00 daily status).
# Set by the control app's re-authorization (HKT ISO).
GOOGLE_REFRESH_TOKEN_ISSUED_AT=
# Optional; default 7 (Google Testing). Not a secret.
# GOOGLE_TOKEN_TTL_DAYS=7
# Target calendar: "primary" or the calendar id from Settings → Integrate calendar
GOOGLE_CALENDAR_ID=primary
# Optional: path to a gitignored OAuth client JSON (never commit the file)
# GOOGLE_CREDENTIALS_PATH=

# --- Hybrid parse fallback (Phase 18 / ADR 0005; optional on Mini) ---
# SpaceXAI key. Empty = rules-only; create-looking misses still recorded.
# XAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.5
# Non-reasoning SKU is tried first when LLM_MODEL is grok-4.5 (15s Slack budget).
# Set equal to LLM_MODEL to disable the second model.
# LLM_FALLBACK_MODEL=grok-4.20-0309-non-reasoning

# --- Phase 33b image extract (default off) ---
# off = today's behaviour exactly (no file download, no vision).
# xai = send PNG/JPEG attached with message text 加event to xAI Grok vision.
# CEC_IMAGE_EXTRACT=off
# LLM_VISION_MODEL=grok-4.20-0309-non-reasoning
# LLM_VISION_FALLBACK_MODEL=
